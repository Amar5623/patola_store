# ─────────────────────────────────────────────────────────────────────────────
# Pragati Patola Art — environment template
# Copy to `.env.local` (vite dev) and `.dev.vars` (wrangler preview).
# Both are gitignored. NEVER commit real keys.
# Full guide: README.md → "Environment & secrets"
# ─────────────────────────────────────────────────────────────────────────────

# ── Build-time (public, baked into the browser bundle) ───────────────────────
# demo       = simulated checkout, no gateway, no sheet writes (Lovable preview)
# production = real Razorpay checkout (test or live is decided by the key below)
VITE_APP_MODE=demo
VITE_INSTAGRAM_URL=https://instagram.com/
VITE_FACEBOOK_URL=https://facebook.com/

# ── Server-only secrets (Cloudflare: `npx wrangler secret put NAME`) ─────────
# Razorpay Dashboard → Account & Settings → API Keys.
# Test keys start with rzp_test_, live keys with rzp_live_.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace_me

# Any strong random string you invent (e.g. `openssl rand -hex 32`); paste the
# SAME value into Razorpay Dashboard → Webhooks → Secret.
RAZORPAY_WEBHOOK_SECRET=replace_me

# Google Apps Script web app URL (…/exec) and the ORDER_SECRET Script Property.
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
GOOGLE_SCRIPT_SECRET=replace_me
